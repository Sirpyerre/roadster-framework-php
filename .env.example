# Roadster Framework - Environment Configuration

#############
# Application
#############
APP_NAME=Roadster
APP_ENV=development
APP_DEBUG=true
APP_KEY=

#############
# Server
#############
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

#############
# RoadRunner
#############
RR_WORKERS=4
RR_MAX_JOBS=1000

#############
# Logging
#############
LOG_LEVEL=debug
LOG_CHANNEL=daily

#############
# Database
#############
# sqlite (default), mysql or pgsql
DB_CONNECTION=sqlite
# SQLite: path relative to the project root, absolute, or :memory:
DB_DATABASE=storage/database.sqlite

# MySQL / PostgreSQL example:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=roadster
# DB_USERNAME=root
# DB_PASSWORD=

#############
# Cache (opcional)
#############
# CACHE_DRIVER=redis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379