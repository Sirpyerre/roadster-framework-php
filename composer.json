{
    "name": "roadster/framework",
    "description": "General-purpose PHP framework for APIs and microservices, with Artisan-style scaffolding and RoadRunner",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Peter",
            "homepage": "https://github.com/sirpyerre"
        }
    ],
    "require": {
        "php": "^8.4.1",
        "ext-json": "*",
        "ext-pdo": "*",
        "doctrine/dbal": "^4.0",
        "doctrine/migrations": "^3.9",
        "laminas/laminas-diactoros": "^3.3",
        "laminas/laminas-servicemanager": "^3.22",
        "mezzio/mezzio": "^3.17",
        "mezzio/mezzio-fastroute": "^3.11",
        "monolog/monolog": "^3.5",
        "spiral/roadrunner-cli": "^2.6",
        "spiral/roadrunner-http": "^3.3",
        "symfony/console": "^7.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "filp/whoops": "^2.15",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^2.34",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Roadster\\": "src/"
        },
        "files": [
            "src/App/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage",
        "analyse": "phpstan analyse --memory-limit=512M",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "bin": [
        "bin/roadster"
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
