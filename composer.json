{
    "name": "roadster/framework",
    "description": "Ultralight PHP framework with RoadRunner for high-performance APIs",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Peter",
            "homepage": "https://github.com/sirpyerre"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "mezzio/mezzio": "^3.17",
        "mezzio/mezzio-fastroute": "^3.11",
        "laminas/laminas-servicemanager": "^3.22",
        "laminas/laminas-diactoros": "^3.3",
        "symfony/console": "^7.0",
        "spiral/roadrunner-cli": "^2.6",
        "spiral/roadrunner-http": "^3.3",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.10",
        "filp/whoops": "^2.15",
        "pestphp/pest": "^2.34"
    },
    "autoload": {
        "psr-4": {
            "Roadster\\": "src/"
        },
        "files": [
            "src/App/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage",
        "analyse": "phpstan analyse",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "bin": [
        "bin/roadster"
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
