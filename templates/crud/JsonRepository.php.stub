<?php

declare(strict_types=1);

namespace Roadster\Infrastructure\{{resource}};

use Roadster\Domain\{{resource}}\{{resource}};
use Roadster\Domain\{{resource}}\{{resource}}RepositoryInterface;

final class Json{{resource}}Repository implements {{resource}}RepositoryInterface
{
    private string $filePath;

    public function __construct(?string $filePath = null)
    {
        $this->filePath = $filePath ?? basePath('storage/{{variableName}}s.json');
        $this->ensureStorageExists();
    }

    /**
     * @return array<{{resource}}>
     */
    public function findAll(): array
    {
        $data = $this->readData();

        return array_map(
            fn(array $item) => new {{resource}}($item),
            $data
        );
    }

    public function findById(string $id): ?{{resource}}
    {
        $data = $this->readData();

        foreach ($data as $item) {
            if ($item['id'] === $id) {
                return new {{resource}}($item);
            }
        }

        return null;
    }

    public function save({{resource}} ${{variableName}}): {{resource}}
    {
        $data = $this->readData();
        $found = false;

        foreach ($data as $index => $item) {
            if ($item['id'] === ${{variableName}}->getId()) {
                $data[$index] = ${{variableName}}->toArray();
                $found = true;
                break;
            }
        }

        if (!$found) {
            $data[] = ${{variableName}}->toArray();
        }

        $this->writeData($data);

        return ${{variableName}};
    }

    public function delete(string $id): bool
    {
        $data = $this->readData();
        $initialCount = count($data);

        $data = array_values(array_filter(
            $data,
            fn(array $item) => $item['id'] !== $id
        ));

        if (count($data) === $initialCount) {
            return false;
        }

        $this->writeData($data);

        return true;
    }

    /**
     * @return array<int, array<string, mixed>>
     */
    private function readData(): array
    {
        if (!file_exists($this->filePath)) {
            return [];
        }

        $content = file_get_contents($this->filePath);

        if ($content === false || $content === '') {
            return [];
        }

        $data = json_decode($content, true);

        return is_array($data) ? $data : [];
    }

    /**
     * @param array<int, array<string, mixed>> $data
     */
    private function writeData(array $data): void
    {
        $json = json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE);

        if ($json !== false) {
            file_put_contents($this->filePath, $json);
        }
    }

    private function ensureStorageExists(): void
    {
        $dir = dirname($this->filePath);

        if (!is_dir($dir)) {
            mkdir($dir, 0755, true);
        }
    }
}
